<!-- Icon-only Sidebar (60px, always visible) -->
<aside class="site-sidebar sidebar-3d">
    <div class="sidebar-3d-panel">
        <!-- Logo -->
        <div class="sidebar-logo">
            <a href="{{@site.url}}" aria-label="Home">
                <svg width="28" height="28" viewBox="0 0 533 533" fill="var(--app-accent)"><path d="M266.5 410.156C230.912 410.156 199.106 402.203 171.081 386.297C143.056 370.39 121.036 348.519 105.022 320.684C89.0072 292.848 81 261.256 81 225.909C81 190.12 89.0072 158.308 105.022 130.472C121.036 102.636 143.056 80.7655 171.081 64.8593C199.106 48.9531 230.912 41 266.5 41C302.087 41 333.671 48.9531 361.252 64.8593C389.277 80.7655 411.297 102.636 427.311 130.472C443.326 158.308 451.555 190.12 452 225.909C452 261.256 443.77 292.848 427.311 320.684C411.297 348.519 389.277 370.39 361.252 386.297C333.671 402.203 302.087 410.156 266.5 410.156ZM266.5 363.763C292.301 363.763 315.433 357.798 335.896 345.868C356.359 333.939 372.373 317.591 383.939 296.824C395.505 276.058 401.288 252.42 401.288 225.909C401.288 199.399 395.505 175.761 383.939 154.994C372.373 133.786 356.359 117.217 335.896 105.287C315.433 93.3579 292.301 87.393 266.5 87.393C240.699 87.393 217.567 93.3579 197.104 105.287C176.641 117.217 160.405 133.786 148.394 154.994C136.828 175.761 131.045 199.399 131.045 225.909C131.045 252.42 136.828 276.058 148.394 296.824C160.405 317.591 176.641 333.939 197.104 345.868C217.567 357.798 240.699 363.763 266.5 363.763Z"/><path d="M378.22 451.578C393.077 451.578 405.121 460.85 405.121 472.289C405.121 483.727 393.077 493 378.22 493H160.945C146.089 493 134.044 483.727 134.044 472.289C134.044 460.85 146.089 451.578 160.945 451.578H378.22Z"/></svg>
            </a>
        </div>

        <hr class="sidebar-divider">

        <!-- Navigation -->
        <nav>
            <!-- Home -->
            <a href="{{@site.url}}" class="sidebar-icon active" title="Home">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                <span class="tooltip">Home</span>
            </a>

            <!-- Latest -->
            <a href="{{@site.url}}" class="sidebar-icon" title="Latest posts">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2"/></svg>
                <span class="tooltip">Latest</span>
            </a>

            <!-- Tags -->
            <a href="{{@site.url}}/tags/" class="sidebar-icon" title="Topics">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                <span class="tooltip">Topics</span>
            </a>

            <!-- Authors -->
            <a href="{{@site.url}}/authors/" class="sidebar-icon" title="Authors">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                <span class="tooltip">Authors</span>
            </a>

            <hr class="sidebar-divider">

            <!-- lisaos.dev link -->
            <a href="https://lisaos.dev" class="sidebar-icon" title="Construct" target="_blank" rel="noopener">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span class="tooltip">Construct</span>
            </a>

            <!-- RSS -->
            <a href="{{@site.url}}/rss/" class="sidebar-icon" title="RSS Feed">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"/></svg>
                <span class="tooltip">RSS Feed</span>
            </a>
        </nav>

        <div class="sidebar-spacer"></div>

        <!-- Construct links -->
        <nav>
            <!-- Domains -->
            <a href="https://domains.lisaos.dev" class="sidebar-icon" title="Domains" target="_blank" rel="noopener">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9"/></svg>
                <span class="tooltip">Domains</span>
            </a>

            <!-- Developer -->
            <a href="https://developer.lisaos.dev" class="sidebar-icon" title="Developer" target="_blank" rel="noopener">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                <span class="tooltip">Developer</span>
            </a>

            {{#if @member}}
            <!-- Logged-in: avatar + user menu -->
            <button class="sidebar-icon" onclick="toggleUserMenu()" title="{{@member.name}}">
                <div class="sidebar-avatar sidebar-avatar-initial" data-name="{{@member.name}}"></div>
                <span class="tooltip">{{@member.name}}</span>
            </button>
            {{else}}
            <!-- Not logged in: login link -->
            <a href="/auth/login" class="sidebar-icon" title="Login with Construct">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                <span class="tooltip">Login with Construct</span>
            </a>
            {{/if}}
        </nav>

        <hr class="sidebar-divider">

        <!-- Theme switcher button -->
        <div>
            <button class="sidebar-icon" onclick="toggleThemePanel()" title="Theme">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/></svg>
                <span class="tooltip">Theme</span>
            </button>
        </div>
    </div>
</aside>

<!-- Theme popover -->
<div class="theme-popover" id="theme-panel">
    <div class="theme-popover-title">Theme</div>
    <!-- filled by JS -->
</div>

{{#if @member}}
<!-- User menu popover -->
<div class="user-menu" id="user-menu">
    <div class="user-menu-header">
        <div class="user-menu-name">{{@member.name}}</div>
        <div class="user-menu-email">{{@member.email}}</div>
    </div>
    <div class="user-menu-divider"></div>
    <a href="https://accounts.lisaos.dev" class="user-menu-item" target="_blank">Settings</a>
    <a href="javascript:void(0)" onclick="document.querySelectorAll('[data-members-signout]')[0]?.click()" class="user-menu-item user-menu-logout">Sign out</a>
</div>
{{/if}}
